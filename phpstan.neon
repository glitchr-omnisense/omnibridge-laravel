# PHPStan at the highest level. phpstan-baseline.neon lists the violations there were when the CI
# started (2026-10-21, written by glitchr-studio/ci's baseline workflow), re-generated on 2026-11-09 with the
# debt left by the moves of omnisense/omnibase's plan "omnibase agnostic", and again on 2026-11-16 for 2.0 (the
# debt moved into src/Base, 693 entries, 1,328 errors; no new error of src), to be paid down gradually: the CI
# fails on any other. Fix one, then drop its entry.
includes:
    - phpstan-baseline.neon

parameters:
    level: max
    paths:
        - src
        - tests
    reportUnmatchedIgnoredErrors: false
