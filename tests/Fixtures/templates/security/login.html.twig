{# The sign-in page of the test application, as JSON a test reads: the form's token, the last refusal, the form as omnibase's templates read it. #}
{"csrf": {{ csrf_token('authenticate')|json_encode|raw }}, "error": {{ error ? error.messageKey|json_encode|raw : 'null' }}, "form": {{ form.vars.name|json_encode|raw }}, "fields": {{ form.children|keys|json_encode|raw }}, "identifier": {{ form[form.children|keys|first].vars.full_name|json_encode|raw }}, "last_username": {{ last_username|json_encode|raw }}, "allow_login_token": {{ form.vars.allow_login_token ? 'true' : 'false' }}, "link_sent": {{ link_sent ? 'true' : 'false' }}, "user": {{ app.user ? app.user.email|json_encode|raw : 'null' }}}
