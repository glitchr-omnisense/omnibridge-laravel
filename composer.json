{
    "name": "omnibridge/laravel",
    "description": "The Laravel host of omniscient/omnibase: its Foundation contracts (urls, translations, locales, access, parameters with the database settings laid over Laravel's config, clock, events...) answered by Laravel's services and seeded in Base\\Contract\\Runtime, Doctrine through omnibridge/doctrine, Twig through omnibridge/twig, and the pieces an omnibase page asks of its framework (Encore tags, the app variable, simple forms).",
    "type": "library",
    "keywords": [
        "laravel",
        "omnibase",
        "omnibridge",
        "twig",
        "doctrine"
    ],
    "homepage": "https://github.com/glitchr-studio/omnibridge-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer"
        }
    ],
    "require": {
        "php": "^8.4",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.4",
        "illuminate/auth": "^12.0|^13.0",
        "illuminate/config": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "omnibridge/doctrine": "^1.0",
        "omnibridge/twig": "^1.0",
        "omniscient/omnibase": "^4.0",
        "omniscient/omnibridge": "^1.0",
        "psr/clock": "^1.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/cache": "^7.0|^8.0",
        "symfony/mailer": "^7.0|^8.0",
        "symfony/routing": "^7.0|^8.0",
        "symfony/translation": "^7.0|^8.0",
        "symfony/yaml": "^7.0|^8.0",
        "twig/twig": "^3.10"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Omnibridge\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibridge\\Laravel\\Tests\\": "tests/",
            "App\\Entity\\": [
                "tests/Fixtures/Entity/",
                "tests/Fixtures/Omnibase/Entity/"
            ],
            "App\\Repository\\": "tests/Fixtures/Omnibase/Repository/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omnibridge\\Laravel\\OmnibridgeServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "omnibridge/composer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "test": "phpunit"
    }
}
